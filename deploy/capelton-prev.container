[Unit]
Description=capelton — capeltonmexico.com & prev.capeltonmexico.com
After=network-online.target traefik.service
Wants=network-online.target

[Container]
ContainerName=capelton
Image=docker.io/library/nginx:1.30.5-alpine
Pull=missing
Network=prosuite.network
Volume=/opt/stacks/capelton/site:/usr/share/nginx/html:ro,Z
Volume=/opt/stacks/capelton/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro,Z

HealthCmd=wget -q --spider http://127.0.0.1/ || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=10s
HealthRetries=3

PodmanArgs=--memory=128m --memory-swap=128m --cpus=0.25

Label=traefik.enable=true
Label=traefik.docker.network=prosuite
Label=traefik.http.services.capelton.loadbalancer.server.port=80

# Router Apex y WWW
Label=traefik.http.routers.capelton.rule=Host(`capeltonmexico.com`) || Host(`www.capeltonmexico.com`)
Label=traefik.http.routers.capelton.entrypoints=websecure
Label=traefik.http.routers.capelton.tls.certresolver=letsencrypt-dns
Label=traefik.http.routers.capelton.service=capelton

# Router Previsualización (Cliente / Staging)
Label=traefik.http.routers.capelton-prev.rule=Host(`prev.capeltonmexico.com`)
Label=traefik.http.routers.capelton-prev.entrypoints=websecure
Label=traefik.http.routers.capelton-prev.tls.certresolver=letsencrypt-dns
Label=traefik.http.routers.capelton-prev.service=capelton

Label=org.prosuite.stack=capelton

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target default.target
